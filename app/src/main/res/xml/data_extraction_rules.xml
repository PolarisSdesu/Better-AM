<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" already turns backup off. These rules restate that
  intent for Android 12+, so no manager preference or hook log can leave the
  device through a cloud backup or a device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
